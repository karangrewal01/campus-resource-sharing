# Campus Resource Sharing Platform - Environment Configuration Template
# Copy this file to .env or configure in Apache/environment

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/campus-resource-sharing

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_resource_sharing
DB_USER=root
DB_PASS=

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
