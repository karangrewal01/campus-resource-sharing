# Prevent direct script execution in the uploads folder
<FilesMatch "(?i:\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|exe|sh|py|bat|cmd))$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
